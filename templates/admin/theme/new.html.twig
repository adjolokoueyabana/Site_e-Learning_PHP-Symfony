{% extends 'base.html.twig' %}

{% block title %}
    Ajouter un thème | Administration
{% endblock %}

{% block meta_description %}
    Ajouter un thème à Knowledge Learning.
{% endblock %}

{% block body %}
    <section class="admin-form-page">
        <header class="page-header">
            <p class="page-eyebrow">
                Administration
            </p>

            <h1 class="page-title">
                Ajouter un thème
            </h1>

            <p class="page-introduction">
                Créez un nouveau thème pour organiser
                les cursus du catalogue.
            </p>
        </header>

        <div class="card admin-form-card">
            {{ include(
                'admin/theme/_form.html.twig',
                {
                    form: form,
                    button_label: 'Créer le thème'
                }
            ) }}
        </div>
    </section>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}
    Modifier {{ course.title }} | Administration
{% endblock %}

{% block meta_description %}
    Modifier un cursus Knowledge Learning.
{% endblock %}

{% block body %}
    <section class="admin-form-page">
        <header class="page-header">
            <p class="page-eyebrow">
                Administration
            </p>

            <h1 class="page-title">
                Modifier le cursus
            </h1>

            <p class="page-introduction">
                Modifiez les informations du cursus
                « {{ course.title }} ».
            </p>
        </header>

        <div class="card admin-form-card">
            {{ include(
                'admin/course/_form.html.twig',
                {
                    form: form,
                    button_label: 'Enregistrer les modifications'
                }
            ) }}
        </div>
    </section>
{% endblock %}
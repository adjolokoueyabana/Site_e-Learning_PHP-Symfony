{% extends 'base.html.twig' %}

{% block title %}
    Mot de passe oublié | Knowledge Learning
{% endblock %}

{% block meta_description %}
    Demandez la réinitialisation de votre mot de passe Knowledge Learning.
{% endblock %}

{% block body %}
    <section class="auth-page">
        <header class="page-header">
            <p class="page-eyebrow">
                Sécurité
            </p>

            <h1 class="page-title">
                Mot de passe oublié
            </h1>

            <p class="page-introduction">
                Saisissez l'adresse e-mail associée à votre compte.
                Si un compte correspond à cette adresse,
                vous recevrez un lien de réinitialisation.
            </p>
        </header>

        <div class="card auth-card">
            {{ form_start(form) }}

                <div class="form-fields">
                    {{ form_row(form.email) }}
                </div>

                <div class="form-actions">
                    <button
                        type="submit"
                        class="btn btn-primary"
                    >
                        Envoyer le lien
                    </button>

                    <a
                        href="{{ path('app_login') }}"
                        class="btn btn-secondary"
                    >
                        Retour à la connexion
                    </a>
                </div>

            {{ form_end(form) }}
        </div>
    </section>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}
    E-mail envoyé | Knowledge Learning
{% endblock %}

{% block meta_description %}
    Confirmation de demande de réinitialisation de mot de passe.
{% endblock %}

{% block body %}
    <section class="auth-page">
        <header class="page-header">
            <p class="page-eyebrow">
                Sécurité
            </p>

            <h1 class="page-title">
                Vérifiez votre boîte e-mail
            </h1>
        </header>

        <div class="card auth-card">
            <div class="alert alert-success">
                <p>
                    Si un compte correspond à l'adresse indiquée,
                    un e-mail contenant un lien de réinitialisation
                    vient d'être envoyé.
                </p>
            </div>

            <p>
                Le lien est temporaire et expire après une heure.
            </p>

            <a
                href="{{ path('app_login') }}"
                class="btn btn-secondary"
            >
                Retour à la connexion
            </a>
        </div>
    </section>
{% endblock %}